/* LAgent TUI 样式（xAgent 风格深色主题） */

Screen {
    background: #1b1f24;
}

#main {
    height: 1fr;
}

/* ---------- 消息流 ---------- */
#chat {
    width: 1fr;
    padding: 1 2;
    background: #1b1f24;
}

.banner {
    border: solid #3a7bd5;
    background: #20262e;
    color: #d7dde4;
    padding: 0 1;
    margin-bottom: 1;
}

.role {
    margin-top: 1;
    padding: 0 1;
    text-style: bold;
}

.role-user {
    border-left: thick #e8a33d;
    color: #e8a33d;
}

.role-agent {
    border-left: thick #3a7bd5;
    color: #5b9bd5;
}

.msg {
    margin: 0 0 1 0;
    padding: 0 1;
    width: 100%;
}

.msg.user {
    background: #20262e;
    border-left: thick #e8a33d;
    color: #eceff3;
}

.msg.assistant {
    background: #20262e;
    border-left: thick #3a7bd5;
}

.msg.system {
    color: #8b949e;
    background: #20262e;
    border-left: thick #6e7681;
}

.msg.hint {
    color: #e8a33d;
    background: #20262e;
    border-left: thick #e8a33d;
}

.msg.interrupted {
    color: #e8a33d;
    background: #20262e;
    border-left: thick #e8a33d;
}

.msg.error {
    color: #f47067;
    background: #20262e;
    border-left: thick #f47067;
}

/* ---------- 工具调用卡片 ---------- */
.tool-card {
    margin: 0 0 1 0;
    border: solid #2ea043;
    background: #20262e;
}

.tool-card.running {
    border: solid #e8a33d;
}

.tool-card > .collapsible--title {
    color: #7ee787;
    padding: 0 1;
}

.tool-card.running > .collapsible--title {
    color: #e8a33d;
}

.tool-body {
    color: #c9d1d9;
    padding: 0 1 1 2;
}

/* ---------- 右侧栏 ---------- */
#sidebar {
    width: 34;
    border-left: solid #3a7bd5;
    background: #161a1f;
    padding: 0 1;
}

.side-title {
    color: #5b9bd5;
    text-style: bold;
    margin-top: 1;
    border-bottom: solid #30363d;
}

#side-session {
    color: #c9d1d9;
    padding: 0 1;
}

.side-tool {
    color: #8b949e;
    padding: 0 0 0 1;
}

.side-tool:hover {
    color: #c9d1d9;
}

/* ---------- 输入行：Spinner + TextArea ---------- */
#input-row {
    dock: bottom;
    margin: 0 1;
    height: auto;
    max-height: 12;
    align: center middle;
}

.spinner {
    width: 3;
    content-align: center middle;
    color: #3a7bd5;
    text-style: bold;
    background: #20262e;
}

.prompt {
    width: 1fr;
    border: solid #3a7bd5;
    background: #20262e;
    color: #eceff3;
    padding: 0 1;
    min-height: 3;
}

.prompt:focus {
    border: solid #5b9bd5;
}

.prompt .text-area--placeholder {
    color: #6e7681;
}

/* ---------- 状态栏 ---------- */
#statusbar {
    dock: bottom;
    background: #161a1f;
    color: #8b949e;
    padding: 0 1;
}

/* ---------- 帮助弹窗 ---------- */
HelpScreen {
    align: center middle;
}

#help {
    width: 72;
    max-width: 90%;
    height: auto;
    max-height: 85%;
    border: solid #3a7bd5;
    background: #161a1f;
    padding: 1 2;
}

#help-title {
    text-style: bold;
    color: #eceff3;
    margin-bottom: 1;
}

.help-section {
    text-style: bold;
    color: #3a7bd5;
    margin-top: 1;
}

#help DataTable {
    margin: 0 1;
}
